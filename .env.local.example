# From Supabase: Project Settings → API (or "API Keys")
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# The anon / publishable key (safe to expose in the browser)
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# The service_role / secret key. Server-only: used to create staff accounts. Never commit.
SUPABASE_SERVICE_ROLE_KEY=
# Public address customers reach (used inside QR codes). Leave empty to use the current site address.
NEXT_PUBLIC_SITE_URL=
# Who can open /admin (comma-separated login emails). Server-only.
ADMIN_EMAILS=
# Where owners message you to subscribe after their trial, e.g. https://m.me/yourpage (optional).
NEXT_PUBLIC_QRAVE_CONTACT_URL=
